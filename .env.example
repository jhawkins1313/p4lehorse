# ---------------------------------------------------------------------------
# P4LEHORSE — environment
# Copy to .env locally. On owensfamily this lives at /srv/apps/p4lehorse/.env
# and is never committed.
# ---------------------------------------------------------------------------

# Signs Payload's auth cookies and reset tokens. Any long random string.
# Generate with: openssl rand -hex 32
# Changing it logs every admin user out.
PAYLOAD_SECRET=change-me-to-a-long-random-string

# SQLite database file. Must sit on the persistent data mount in production
# so it survives container recreation.
#   local:      file:./p4lehorse.db
#   production: file:/data/p4lehorse.db   (bind-mounted from /srv/apps/p4lehorse-data)
DATABASE_URI=file:./p4lehorse.db

# Where uploaded media (album art, artist photos) is written.
#   local:      ./media
#   production: /data/media
MEDIA_DIR=./media

# Public origin of the site. Used for absolute og:image URLs, RSS, sitemap and
# canonical links. No trailing slash.
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Port the Next server binds inside the container. The Cloudflare Tunnel routes
# the public hostname to this port by service name; nothing is published to the host.
PORT=3000

# --- Optional ---------------------------------------------------------------

# Resend API key. Only needed if you want subscribe confirmations or password
# resets to actually send mail. Leave blank and Payload logs to console instead.
RESEND_API_KEY=

# From address for outbound mail. Must be on a domain verified in Resend.
EMAIL_FROM=P4LEHORSE <noreply@p4lehorse.com>
