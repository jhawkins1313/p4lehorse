{
  "name": "p4lehorse",
  "version": "1.0.0",
  "private": true,
  "description": "P4LEHORSE \u2014 a digital space for the extreme and the fringe",
  "type": "module",
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev",
    "build": "cross-env NODE_OPTIONS=--no-deprecation next build",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "lint": "cross-env NODE_OPTIONS=--no-deprecation next lint",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "seed": "npm run migrate && cross-env NODE_OPTIONS=--no-deprecation tsx src/seed/index.ts",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "migrate": "cross-env NODE_OPTIONS=--no-deprecation payload migrate",
    "migrate:create": "cross-env NODE_OPTIONS=--no-deprecation payload migrate:create",
    "predev": "npm run migrate"
  },
  "dependencies": {
    "@payloadcms/db-sqlite": "3.88.0",
    "@payloadcms/next": "3.88.0",
    "@payloadcms/plugin-seo": "3.88.0",
    "@payloadcms/richtext-lexical": "3.88.0",
    "@payloadcms/ui": "3.88.0",
    "cross-env": "^7.0.3",
    "dotenv": "^17.4.2",
    "graphql": "^16.9.0",
    "next": "16.3.2",
    "payload": "3.88.0",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "sass": "^1.103.1",
    "sharp": "^0.34.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": "^18.20.2 || >=20.9.0"
  }
}
